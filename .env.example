# =============================================================================
# ANTHROPIC (Claude) - Required
# =============================================================================
# Get your key: https://console.anthropic.com/
# Currently required for all agents in the system
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: Specify Claude model version
# Default: claude-sonnet-4-5-20250929
# Options: claude-opus-4-5-20250929, claude-sonnet-4-5-20250929, claude-haiku-4-5-20250929
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# =============================================================================
# GROQ - Optional (Future multi-provider support)
# =============================================================================
# Get your key: https://console.groq.com/
# Fast inference with generous free tier
GROQ_API_KEY=your-groq-key-here

# Optional: Specify Groq model
# Options: mixtral-8x7b-32768, llama2-70b-4096, gemma-7b-it
GROQ_MODEL=mixtral-8x7b-32768

# =============================================================================
# OPENAI (GPT) - Optional
# =============================================================================
# Get your key: https://platform.openai.com/api-keys
# Alternative LLM provider
OPENAI_API_KEY=your-openai-key-here

# Optional: Specify GPT model
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# =============================================================================
# HUGGINGFACE - Optional
# =============================================================================
# Get your key: https://huggingface.co/settings/tokens
# Access to open-source models
HUGGINGFACE_API_KEY=your-huggingface-token-here

# Optional: Specify model from HuggingFace Hub
HUGGINGFACE_MODEL=meta-llama/Llama-2-70b-chat-hf

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
# Database path for memory storage
DB_PATH=data/memory.db

# Maximum iterations for agent loops (prevents infinite loops)
MAX_AGENT_ITERATIONS=15

# Enable verbose logging for debugging
VERBOSE=true

# =============================================================================
# FUTURE: EXTERNAL INTEGRATIONS (Phase 2+)
# =============================================================================
# Google APIs (for Phase 5 - Writing Agent with Google Docs/Keep)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Search APIs (for enhanced Research Agent in Phase 2)
# SERPAPI_KEY=
# GOOGLE_MAPS_API_KEY=
# YELP_API_KEY=

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Replace placeholder values with your actual API keys
#
# 3. NEVER commit .env to Git (it's already in .gitignore)
#
# 4. Get API keys from:
#    - Anthropic (Required): https://console.anthropic.com/
#    - Groq (Optional): https://console.groq.com/
#    - OpenAI (Optional): https://platform.openai.com/api-keys
#    - HuggingFace (Optional): https://huggingface.co/settings/tokens
#
# Note: The multi-provider abstraction layer (core/llm_provider.py) is available
# for future use, but not required for the current simple setup.
